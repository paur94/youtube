# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://studio:studio@localhost:5440/kids_studio

# Claude API (Story Workshop). Server-side only: never prefix with NEXT_PUBLIC_.
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium   # low | medium | high | xhigh | max

# Higgsfield API (Production Studio). Server-side only. Create a key pair at
# https://console.higgsfield.ai - API usage is billed separately from a web subscription.
# Leave empty to use the manual generate-and-import workflow.
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# Hedra API v3 (Character 3 talking-character clips). Server-side only. Create a key at
# https://www.hedra.com/api-profile ("<key_id>:<secret>") and fund the API wallet: studio credits don't apply.
HEDRA_API_KEY=

# FFmpeg (Shorts Studio rendering and measurements). Free; only needed when ffmpeg/ffprobe aren't on PATH.
# FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/tools/ffmpeg/bin/ffprobe.exe

# Where generated and imported images/clips are stored (default: ./storage/media)
# MEDIA_DIR=

# YouTube channel connection (Publishing). Server-side only: never prefix with NEXT_PUBLIC_.
# Google Cloud Console -> enable "YouTube Data API v3" -> OAuth client of type "Web application" with
# the authorized redirect URI http://127.0.0.1:3000/api/youtube/callback (match how you open the app).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the stored OAuth tokens. 32 random bytes, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it means reconnecting the channel.
YOUTUBE_TOKEN_KEY=
# Optional: only when the app is reached through a different origin than the one it sees (e.g. a proxy)
# GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/youtube/callback
